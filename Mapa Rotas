    function renderizarAreasAgendadasNoMapa() {
      if (!camadaAreasAgendadas) return;
      camadaAreasAgendadas.clearLayers();

      let mapaAreas = {};
      todosOsPontos.forEach(function(p) {
        if (p.dataAgendadaIso && p.equipe && p.areaGeoJson) {
          let chaveArea = p.dataAgendadaIso + "||" + p.equipe;
          if (!mapaAreas[chaveArea]) {
            mapaAreas[chaveArea] = {
              dataBr: p.dataAgendadaBr,
              equipe: p.equipe,
              geoJson: p.areaGeoJson,
              qtd: 0
            };
          }
          mapaAreas[chaveArea].qtd++;
        }
      });

      Object.keys(mapaAreas).forEach(function(chave) {
        let item = mapaAreas[chave];
        try {
          let geoData = JSON.parse(item.geoJson);
          let shapeLayer = null;

          if (geoData.tipo === "circulo") {
            shapeLayer = L.circle([geoData.lat, geoData.lng], {
              radius: geoData.raio,
              color: '#a855f7',
              weight: 2,
              dashArray: '6, 6',
              fillColor: '#a855f7',
              fillOpacity: 0.18
            });
          } else if (geoData.tipo === "retangulo") {
            shapeLayer = L.rectangle(geoData.bounds, {
              color: '#a855f7',
              weight: 2,
              dashArray: '6, 6',
              fillColor: '#a855f7',
              fillOpacity: 0.18
            });
          } else if (geoData.tipo === "poligono") {
            shapeLayer = L.polygon(geoData.latlngs, {
              color: '#a855f7',
              weight: 2,
              dashArray: '6, 6',
              fillColor: '#a855f7',
              fillOpacity: 0.18
            });
          }

          if (shapeLayer) {
            shapeLayer.bindPopup(
              '<div style="font-size:12px;">' +
                '<b style="color:#8b5cf6;">ÁREA AGENDADA / RESERVADA</b><br>' +
                '<b>Equipe:</b> ' + escapeHtml(item.equipe) + '<br>' +
                '<b>Data do Atendimento:</b> ' + escapeHtml(item.dataBr) + '<br>' +
                '<small style="color:#94a3b8;">' + item.qtd + ' pendência(s) na zona</small>' +
              '</div>'
            );
            camadaAreasAgendadas.addLayer(shapeLayer);
          }
        } catch (e) {
          console.error("Erro ao desenhar área reservada:", e);
        }
      });
    }

