        let latStr = pt.lat !== null ? pt.lat.toFixed(5) : "0";
        let lngStr = pt.lng !== null ? pt.lng.toFixed(5) : "0";
        let chaveUnicaLocal = (pt.estabelecimento || "").trim().toUpperCase() + "||" + (pt.cidadeUf || "").trim().toUpperCase() + "||" + latStr + "||" + lngStr;

        if (!mapaLocais[chaveUnicaLocal]) {
          mapaLocais[chaveUnicaLocal] = {
            estabelecimento: pt.estabelecimento,
            tipoLocalidade: pt.tipoLocalidade || pt.tipo || "Local",
            cidadeUf: pt.cidadeUf,
            lat: pt.lat,
            lng: pt.lng,
            qtdPendencias: 0,
            idsOS: []
          };
          locaisUnicos.push(mapaLocais[chaveUnicaLocal]);
        }
        mapaLocais[chaveUnicaLocal].qtdPendencias += 1;
        if (pt.idOS) mapaLocais[chaveUnicaLocal].idsOS.push(pt.idOS);
      });

      htmlRows += locaisUnicos.map(function(loc, idx) {
        let tagQtd = loc.qtdPendencias > 1 
          ? ' <span style="color:#2563eb; font-weight:bold; font-size:10px;">(' + loc.qtdPendencias + ' Pendências)</span>' 
          : ' <span style="color:#64748b; font-size:10px;">(1 Pendência)</span>';

        let strIDs = loc.idsOS.length > 0 ? '<small style="color:#38bdf8; display:block;">OS: ' + escapeHtml(loc.idsOS.join(", ")) + '</small>' : '';

        return '<tr>' +
          '<td><b>PARADA ' + (idx + 1) + '</b></td>' +
          '<td><b>' + escapeHtml(loc.estabelecimento) + '</b>' + tagQtd + '<br><small style="color:#2563eb;">' + escapeHtml(loc.tipoLocalidade) + '</small>' + strIDs + '</td>' +
          '<td>' + escapeHtml(loc.cidadeUf) + '</td>' +
          '<td style="font-family:monospace;">' + loc.lat.toFixed(6) + ', ' + loc.lng.toFixed(6) + '</td>' +
          '<td style="text-align:center;"><a href="https://www.google.com/maps/search/?api=1&query=' + loc.lat + ',' + loc.lng + '" target="_blank">Rota</a></td>' +
        '</tr>';
      }).join("");

      tbodyRoteiro.innerHTML = htmlRows;
    }

    function aplicarFiltrosGlobais() {
      let resultado = Array.from(todosOsPontos);

      const ufsSel = Array.from(document.querySelectorAll('.chkUf')).filter(function(c) { return c.checked; }).map(function(c) { return c.value; });
      const cidadesSel = Array.from(document.querySelectorAll('.chkCidade')).filter(function(c) { return c.checked; }).map(function(c) { return c.value; });
      const tiposSel = Array.from(document.querySelectorAll('.chkTipo')).filter(function(c) { return c.checked; }).map(function(c) { return c.value; });
      const sitSel = Array.from(document.querySelectorAll('.chkSit')).filter(function(c) { return c.checked; }).map(function(c) { return c.value; });

      resultado = resultado.filter(function(i) { return !idsExcluidosManual.has(i.idLinha); });

      if (apenasModoSemGps) {
        resultado = resultado.filter(function(i) { return i.semGps; });
      }

      resultado = resultado.filter(function(i) { return ufsSel.includes(i.uf) || i.semGps; });
      resultado = resultado.filter(function(i) { return cidadesSel.includes(i.cidadeUf) || i.semGps; });
      resultado = resultado.filter(function(i) { return tiposSel.includes(i.tipoLocalidade) || i.semGps; });
      resultado = resultado.filter(function(i) { return sitSel.includes(i.situacao) || i.semGps; });

      const valDataLim = document.getElementById("inputDataBacklog").value;
      if (valDataLim) {
        let tLimite = new Date(valDataLim + "T23:59:59").getTime();

        resultado = resultado.filter(function(i) {
          if (!i.dataInicialIso && !i.dataInicial) return false;

          let tItem = 0;
          if (i.dataInicialIso) {
            tItem = new Date(i.dataInicialIso + "T00:00:00").getTime();
          } else if (i.dataInicial) {
            let limpo = i.dataInicial.toString().split(' ')[0];
            let partes = limpo.split('/');
            if (partes.length === 3) {
              tItem = new Date(partes[2] + "-" + partes[1] + "-" + partes[0] + "T00:00:00").getTime();
            }
          }

          return tItem > 0 && tItem <= tLimite;
        });
      }

      let pontosFiltradosComArea = Array.from(resultado);

      if (formaDesenhadaAtiva) {
        if (formaDesenhadaAtiva instanceof L.Circle) {
          let centro = formaDesenhadaAtiva.getLatLng(), raio = formaDesenhadaAtiva.getRadius();
          pontosFiltradosComArea = pontosFiltradosComArea.filter(function(pt) { return !pt.semGps && centro.distanceTo(L.latLng(pt.lat, pt.lng)) <= raio; });
        } else if (formaDesenhadaAtiva instanceof L.Rectangle) {
          let bounds = formaDesenhadaAtiva.getBounds();
          pontosFiltradosComArea = pontosFiltradosComArea.filter(function(pt) { return !pt.semGps && bounds.contains(L.latLng(pt.lat, pt.lng)); });
        } else if (formaDesenhadaAtiva instanceof L.Polygon) {
          let poly = formaDesenhadaAtiva.getLatLngs()[0];
          pontosFiltradosComArea = pontosFiltradosComArea.filter(function(pt) { return !pt.semGps && pontoEmPoligonoLeaflet(L.latLng(pt.lat, pt.lng), poly); });
        }
        document.getElementById("subtituloSelecao").innerText = "Filtro Aplicado: " + pontosFiltradosComArea.length + " registro(s).";
      } else if (apenasModoSemGps) {
        document.getElementById("subtituloSelecao").innerText = "Exibindo apenas os " + resultado.length + " registros SEM GPS.";
      } else {
        document.getElementById("subtituloSelecao").innerText = "Filtro Aplicado: " + resultado.length + " registro(s).";
      }

      renderizarMarcadoresELinhasNoMapa(resultado, pontosFiltradosComArea);
      renderizarTabela(pontosFiltradosComArea);
    }

    function pontoEmPoligonoLeaflet(latlng, poly) {
      let x = latlng.lat, y = latlng.lng, inside = false;
      for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
        let xi = poly[i].lat, yi = poly[i].lng, xj = poly[j].lat, yj = poly[j].lng;
        let intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
        if (intersect) inside = !inside;
      }
      return inside;
    }

