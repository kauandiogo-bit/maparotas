    let camadaLinhaGuiaSuave = null;
    let camadaMedicaoDistancia = null;
    
    let modoMedicaoAtivo = false;
    let modoRotaAtivo = false;
    let pontosMedicao = [];
    let formaDesenhadaAtiva = null;
    let primeiraCargaGlobal = true;

    let rotaAtivaCalData = null;
    let rotaAtivaCalEquipe = null;

    let mesAtualCal = 7;
    let anoAtualCal = 2026;
    const NOMES_MESES = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];

    let pontoPartida = {
      nome: "Sede Matriz",
      lat: -6.168818,
      lng: -38.490160
    };

    let ufsDisponiveis = [];
    let cidadesDisponiveis = [];
    let tiposDisponiveis = [];
    let situacoesDisponiveis = [];
    let apenasModoSemGps = false;

    // ===== SESSÃO =====
    let sessaoToken = null;
    let sessaoLogin = null;
    let loginPendenteTroca = null; // guarda login quando precisa trocar senha

    const coresEstados = {
      "CE": "#3b82f6", "BA": "#f59e0b", "PE": "#10b981", "PB": "#8b5cf6",
      "RN": "#ec4899", "AL": "#06b6d4", "SE": "#f97316", "PI": "#84cc16",
      "MA": "#6366f1", "GO": "#14b8a6", "MS": "#a855f7"
    };

    const coresEquipes = {
      "KELVIN": "background:#2563eb; color:#ffffff;",
      "FELLIPE E RENNAN": "background:#059669; color:#ffffff;",
      "JOHNSON E ERISON": "background:#7c3aed; color:#ffffff;",
      "RENNAN": "background:#f59e0b; color:#0f172a;",
      "RODRIGO": "background:#059669; color:#ffffff;"
    };

    function escapeHtml(str) {
      if (str === null || str === undefined) return "";
      return str.toString()
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // ===== LOGIN =====
    function executarLogin() {
      const login = document.getElementById("loginUsuario").value.trim();
      const senha = document.getElementById("loginSenha").value;
      const erroEl = document.getElementById("loginErro");
      const btn = document.getElementById("btnLogin");
      const blocoTroca = document.getElementById("blocoTrocaSenha");

      erroEl.innerText = "";

      // Modo "troca de senha" já visível -> processar troca
      if (blocoTroca.style.display !== "none") {
        const nova = document.getElementById("loginNovaSenha").value;
        const nova2 = document.getElementById("loginNovaSenha2").value;

        if (nova.length < 4) { erroEl.innerText = "Nova senha muito curta."; return; }
        if (nova !== nova2) { erroEl.innerText = "As senhas não conferem."; return; }

        btn.disabled = true; btn.innerText = "Salvando...";
        google.script.run
          .withSuccessHandler(function(res) {
            btn.disabled = false; btn.innerText = "Entrar";
            if (!res.sucesso) { erroEl.innerText = res.mensagem; return; }

            // Após trocar, volta pro login normal
            document.getElementById("blocoTrocaSenha").style.display = "none";
            document.getElementById("loginAvisoTroca").style.display = "none";
            document.getElementById("loginSenha").value = "";
            document.getElementById("loginNovaSenha").value = "";
            document.getElementById("loginNovaSenha2").value = "";
            loginPendenteTroca = null;
            erroEl.style.color = "#34d399";
            erroEl.innerText = "Senha alterada! Faça login com a nova senha.";
            setTimeout(function() { erroEl.style.color = "#f87171"; erroEl.innerText = ""; }, 4000);
          })
          .withFailureHandler(function(e) {
            btn.disabled = false; btn.innerText = "Entrar";
            erroEl.innerText = "Erro: " + e.message;
          })
          .trocarSenha(loginPendenteTroca, senha, nova);

        return;
      }

      if (!login || !senha) { erroEl.innerText = "Preencha login e senha."; return; }

      btn.disabled = true; btn.innerText = "Entrando...";
      google.script.run
        .withSuccessHandler(function(res) {
          btn.disabled = false; btn.innerText = "Entrar";

          if (!res.sucesso) {
            erroEl.innerText = res.mensagem || "Falha no login.";
            return;
          }

          if (res.precisaTrocarSenha) {
            loginPendenteTroca = res.login;
            document.getElementById("loginAvisoTroca").style.display = "block";
            document.getElementById("blocoTrocaSenha").style.display = "block";
            document.getElementById("btnLogin").innerText = "Salvar nova senha";
            erroEl.innerText = "";
            return;
          }

          // Login OK
          sessaoToken = res.token;
          sessaoLogin = res.login;
          document.getElementById("lblUsuarioLogado").innerText = res.login;
          document.getElementById("telaLogin").classList.add("hidden");
          iniciarPainel();
        })
        .withFailureHandler(function(e) {
          btn.disabled = false; btn.innerText = "Entrar";
          erroEl.innerText = "Erro: " + e.message;
        })
        .fazerLogin(login, senha);
    }

    function fazerLogout() {
      if (sessaoToken) {
        google.script.run.encerrarSessao(sessaoToken);
      }
      sessaoToken = null;
      sessaoLogin = null;
      todosOsPontos = [];
      pontosAtualmenteExibidos = [];

      document.getElementById("telaLogin").classList.remove("hidden");
      document.getElementById("loginUsuario").value = "";
      document.getElementById("loginSenha").value = "";
      document.getElementById("loginNovaSenha").value = "";
      document.getElementById("loginNovaSenha2").value = "";
      document.getElementById("blocoTrocaSenha").style.display = "none";
      document.getElementById("loginAvisoTroca").style.display = "none";
      document.getElementById("btnLogin").innerText = "Entrar";
      document.getElementById("loginErro").innerText = "";

      // Esvazia tabela e camadas
      document.getElementById("corpoTabela").innerHTML = '<tr><td colspan="9" style="text-align: center; padding: 20px; color: #64748b;">Faça login para visualizar.</td></tr>';
      if (camadaMarcadores) camadaMarcadores.clearLayers();
      if (camadaAreasAgendadas) camadaAreasAgendadas.clearLayers();
    }

    let painelIniciado = false;
    function iniciarPainel() {
      if (!painelIniciado) {
        painelIniciado = true;
        inicializarMapa();
        document.addEventListener('click', function(e) {
          if (!e.target.closest('.dropdown-multiselect')) {
            document.querySelectorAll('.dropdown-menu-box').forEach(function(d) { d.classList.add('hidden'); });
          }
        });
      } else {
        setTimeout(function() { if (map) map.invalidateSize(); }, 200);
      }
      carregarPontos();
    }

    // ===== RESTO DO CÓDIGO (mantido) =====

    function alternarAbaPrincipal(aba) {
      const secMapa = document.getElementById("secaoMapaContainer");
      const secAgenda = document.getElementById("secaoAgenda");
      const btnMapa = document.getElementById("btnAbaMapa");
      const btnAgenda = document.getElementById("btnAbaAgenda");
      const filtros = document.getElementById("barFiltrosTopo");
      const legenda = document.getElementById("barraLegendaMap");

      if (aba === 'agenda') {
        secMapa.style.display = "none";
        secAgenda.style.display = "flex";
        btnMapa.classList.remove("ativa");
        btnAgenda.classList.add("ativa");
        filtros.style.display = "none";
        legenda.style.display = "none";
        montarCalendarioAgenda();
      } else {
        secAgenda.style.display = "none";
        secMapa.style.display = "flex";
        btnAgenda.classList.remove("ativa");
        btnMapa.classList.add("ativa");
        filtros.style.display = "flex";
        legenda.style.display = "flex";
        setTimeout(function() { if (map) map.invalidateSize(); }, 200);
      }
    }

    function togglePainelLateral() {
      const container = document.getElementById("secaoMapaContainer");
      const icone = document.getElementById("txtIconeToggle");
      const rotulo = document.getElementById("txtRotuloToggle");

      container.classList.toggle("painel-recolhido");
      const estaRecolhido = container.classList.contains("painel-recolhido");

      if (estaRecolhido) {
        icone.innerText = "◀";
        rotulo.innerText = "Exibir Tabela";
      } else {
        icone.innerText = "▶";
        rotulo.innerText = "Ocultar Tabela";
      }

      setTimeout(function() { if (map) map.invalidateSize(); }, 310);
    }

    function inicializarMapa() {
      map = L.map('map').setView([-6.168818, -38.490160], 8);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors'
      }).addTo(map);

      carregarCamadaColoridaEstados();

      drawnItems = new L.FeatureGroup();
      map.addLayer(drawnItems);
      camadaAreasAgendadas = L.featureGroup().addTo(map);
      camadaLinhaGuiaSuave = L.featureGroup().addTo(map);
      camadaMarcadores = L.featureGroup().addTo(map);
      camadaMedicaoDistancia = L.featureGroup().addTo(map);

      let drawControl = new L.Control.Draw({
        draw: {
          polyline: false, marker: false, circlemarker: false,
          polygon: { allowIntersection: false, shapeOptions: { color: '#8b5cf6', weight: 2, fillColor: '#8b5cf6', fillOpacity: 0.2 } },
          rectangle: { shapeOptions: { color: '#8b5cf6', weight: 2, fillColor: '#8b5cf6', fillOpacity: 0.2 } },
          circle: { shapeOptions: { color: '#8b5cf6', weight: 2, fillColor: '#8b5cf6', fillOpacity: 0.2 } }
        },
        edit: { featureGroup: drawnItems, remove: true }
      });
      map.addControl(drawControl);

      map.on(L.Draw.Event.CREATED, function (e) {
        drawnItems.clearLayers();
        formaDesenhadaAtiva = e.layer;
        drawnItems.addLayer(formaDesenhadaAtiva);
        aplicarFiltrosGlobais();
      });

      map.on(L.Draw.Event.DELETED, function () {
        limparSelecaoDesenho();
      });

      map.on('click', function(e) {
        if (!modoMedicaoAtivo) return;
        processarCliqueMedicao(e.latlng);
      });

      setTimeout(function() { if (map) map.invalidateSize(); }, 400);
    }

    function toggleModoMedicao() {
      modoMedicaoAtivo = !modoMedicaoAtivo;
      pontosMedicao = [];
      camadaMedicaoDistancia.clearLayers();

      const btn = document.getElementById("btnModoMedicao");
