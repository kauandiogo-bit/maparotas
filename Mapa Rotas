    }

    function toggleModoRota() {
      modoRotaAtivo = !modoRotaAtivo;

      const btn = document.getElementById("btnModoRota");
      const legendaModoRota = document.getElementById("legendaModoRota");

      if (modoRotaAtivo) {
        btn.style.backgroundColor = "#000000";
        btn.style.color = "#ffffff";
        btn.style.borderColor = "#000000";
        btn.innerText = "Modo Rota (Ativo)";
        if (legendaModoRota) legendaModoRota.style.display = "inline";
      } else {
        btn.style.backgroundColor = "";
        btn.style.color = "#e2e8f0";
        btn.style.borderColor = "#64748b";
        btn.innerText = "Modo Rota";
        if (legendaModoRota) legendaModoRota.style.display = "none";
      }

      aplicarFiltrosGlobais();
    }

    function processarCliqueMedicao(latlng) {
      pontosMedicao.push(latlng);

      let markerTemp = L.circleMarker(latlng, { radius: 6, color: '#10b981', fillColor: '#10b981', fillOpacity: 1 });
      camadaMedicaoDistancia.addLayer(markerTemp);

      if (pontosMedicao.length === 2) {
        let pA = pontosMedicao[0];
        let pB = pontosMedicao[1];
        let distLinhaReta = calcularDistanciaValidaEntreCoordenadas(pA.lat, pA.lng, pB.lat, pB.lng);

        let coordsStr = pA.lng + "," + pA.lat + ";" + pB.lng + "," + pB.lat;
        fetch("https://router.project-osrm.org/route/v1/driving/" + coordsStr + "?overview=full&geometries=geojson")
          .then(function(res) { return res.json(); })
          .then(function(data) {
            let distRodovia = distLinhaReta;
            if (data.routes && data.routes.length > 0) {
              distRodovia = data.routes[0].distance / 1000;
              let polyOSRM = L.geoJSON(data.routes[0].geometry, { style: { color: '#10b981', weight: 4, dashArray: '6,6' } });
              camadaMedicaoDistancia.addLayer(polyOSRM);
            } else {
              let polyReta = L.polyline([pA, pB], { color: '#10b981', weight: 3, dashArray: '4,4' });
              camadaMedicaoDistancia.addLayer(polyReta);
            }

            let htmlMed = '<div style="font-size:12px; text-align:center;">' +
              '<b style="color:#10b981;">CÁLCULO DE DISTÂNCIA</b><br>' +
              'Rodovia Real: <b>' + distRodovia.toFixed(1) + ' km</b><br>' +
              'Linha Reta: <small>' + distLinhaReta.toFixed(1) + ' km</small><hr style="margin:4px 0;">' +
