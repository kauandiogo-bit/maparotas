    function montarCalendarioAgenda() {
      const grid = document.getElementById("gridDiasCalendario");
      if (!grid) return;
      grid.innerHTML = "";

      document.getElementById("txtMesAnoCalendario").innerText = NOMES_MESES[mesAtualCal] + " " + anoAtualCal;

      const primeiroDiaSemana = new Date(anoAtualCal, mesAtualCal, 1).getDay();
      const totalDiasMes = new Date(anoAtualCal, mesAtualCal + 1, 0).getDate();

      for (let i = 0; i < primeiroDiaSemana; i++) {
        let divVazia = document.createElement("div");
        grid.appendChild(divVazia);
      }

      let hojeObj = new Date();
      let hojeIso = hojeObj.toISOString().split('T')[0];

      for (let d = 1; d <= totalDiasMes; d++) {
        let diaIso = anoAtualCal + "-" + (mesAtualCal + 1).toString().padStart(2, '0') + "-" + d.toString().padStart(2, '0');
        let ehHoje = (diaIso === hojeIso);

        let boxDia = document.createElement("div");
        boxDia.className = "cal-day-box " + (ehHoje ? "hoje-highlight" : "");
        boxDia.id = "calbox-" + diaIso;

        boxDia.addEventListener("dragover", function(e) {
          e.preventDefault();
          boxDia.style.borderColor = "#10b981";
        });
        boxDia.addEventListener("dragleave", function() {
          boxDia.style.borderColor = "#334155";
        });
        boxDia.addEventListener("drop", function(e) {
          boxDia.style.borderColor = "#334155";
          aoSoltarEquipeNoDia(e, diaIso);
        });

        let pontosDoDia = todosOsPontos.filter(function(p) { 
          return p.dataAgendadaIso === diaIso && p.equipe && p.areaGeoJson && p.areaGeoJson.trim() !== ""; 
