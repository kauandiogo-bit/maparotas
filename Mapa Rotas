          "\"" + (pt.diasPendente || '').replace(/"/g, '""') + "\"",
          "\"" + (pt.dataAgendadaBr || '').replace(/"/g, '""') + "\"",
          "\"" + (pt.equipe || '').replace(/"/g, '""') + "\"",
          "\"" + (pt.lat !== null ? pt.lat : '') + "\"",
          "\"" + (pt.lng !== null ? pt.lng : '') + "\"",
          "\"" + (pt.semGps ? 'SEM GPS' : 'OK') + "\""
        ];
        conteudoCsv += linha.join(";") + "\n";
      });

      let blob = new Blob([conteudoCsv], { type: 'text/csv;charset=utf-8;' });
      let url = URL.createObjectURL(blob);
      let a = document.createElement("a");
      a.href = url;
      a.download = "Rotas_Ocorrencias_" + new Date().toISOString().split('T')[0] + ".csv";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function gerarRelatorioPDF() {
      if (!pontosAtualmenteExibidos || pontosAtualmenteExibidos.length === 0) {
        alert("Nenhum registro para gerar o PDF.");
        return;
      }
      window.print();
    }
  </script>
</body>
</html>
