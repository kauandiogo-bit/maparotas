          htmlPilulas += '<span class="badge-equipe-pilula" style="' + estiloCor + '" draggable="true" ondragstart="aoArrastarEquipe(event, \'' + escapeHtml(eq) + '\', \'' + diaIso + '\')" onclick="abrirRotaDetalhesCalendario(\'' + diaIso + '\', \'' + escapeHtml(eq) + '\')">' + escapeHtml(eq) + ' (' + qtd + ')</span>';
        });

        boxDia.innerHTML = 
          '<div style="font-size: 11px; font-weight: bold; color: ' + (ehHoje ? '#10b981' : '#94a3b8') + ';">' + d + '</div>' +
          '<div style="display: flex; flex-direction: column; gap: 2px; flex: 1; justify-content: flex-start; overflow-y: auto;">' +
            htmlPilulas +
          '</div>';

        grid.appendChild(boxDia);
      }
