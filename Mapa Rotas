<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <base target="_top">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel de Rotas e Ocorrências</title>
  
  <link rel="icon" type="image/png" href="https://maps.gstatic.com/mapfiles/maps_lite/images/2x/navigation_24px.png" />

  <!-- Leaflet Core -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Leaflet Draw Plugin -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background-color: #0f172a; color: #e2e8f0; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

    /* ===== TELA DE LOGIN ===== */
    .tela-login {
      position: fixed; inset: 0; z-index: 50000;
      background: radial-gradient(circle at top, #1e293b 0%, #0f172a 70%);
      display: flex; align-items: center; justify-content: center;
    }
    .tela-login.hidden { display: none !important; }
    .login-card {
      background: #1e293b; border: 1px solid #334155; border-radius: 14px;
      padding: 28px 26px; width: 100%; max-width: 380px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7);
    }
    .login-card h1 { font-size: 18px; color: #f8fafc; margin-bottom: 4px; }
    .login-card p.sub { font-size: 11px; color: #94a3b8; margin-bottom: 18px; }
    .login-card label { font-size: 10px; color: #94a3b8; font-weight: bold; display: block; margin-bottom: 4px; text-transform: uppercase; }
    .login-card input {
      width: 100%; height: 38px; padding: 0 10px; border-radius: 7px;
      background: #0f172a; border: 1px solid #334155; color: #f1f5f9;
      font-size: 13px; outline: none; margin-bottom: 12px;
    }
    .login-card input:focus { border-color: #3b82f6; }
    .login-card button.primario {
      width: 100%; height: 40px; border: none; border-radius: 7px;
      background: #2563eb; color: #fff; font-weight: bold; font-size: 13px;
      cursor: pointer; transition: all 0.2s ease;
    }
    .login-card button.primario:hover { background: #1d4ed8; }
    .login-card button.primario:disabled { opacity: 0.6; cursor: not-allowed; }
    .login-erro { color: #f87171; font-size: 11px; margin-top: 8px; min-height: 14px; }
    .login-aviso { color: #fbbf24; font-size: 11px; margin-bottom: 10px; }

    /* ===== RESTO DO PAINEL ===== */
    header { background-color: #1e293b; padding: 8px 16px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; flex-shrink: 0; }
    .titulo-box h1 { font-size: 15px; color: #f8fafc; font-weight: bold; }

    .aba-nav-item { padding: 6px 14px; border-radius: 6px; font-size: 11px; font-weight: bold; cursor: pointer; color: #94a3b8; border: 1px solid transparent; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 4px; }
    .aba-nav-item.ativa { background-color: #2563eb; color: #ffffff; border-color: #3b82f6; }
    .aba-nav-item:hover:not(.ativa) { background-color: #334155; color: #f8fafc; }

    .painel-filtros { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    
    .btn-filt, select, input[type="text"], input[type="date"] { 
      background-color: #0f172a; 
      border: 1px solid #334155; 
      color: #f1f5f9; 
      font-size: 11px; 
      height: 32px; 
      padding: 0 10px; 
      border-radius: 6px; 
      cursor: pointer; 
      outline: none; 
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .btn-filt:hover, select:hover, input[type="date"]:hover { background-color: #1e293b; border-color: #475569; }

    .legenda-bar { background-color: rgba(30, 41, 59, 0.8); padding: 6px 20px; border-bottom: 1px solid #334155; display: flex; gap: 15px; font-size: 10px; align-items: center; flex-shrink: 0; }
    .dot-legenda { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 4px; }

    .main-container { flex: 1; display: flex; overflow: hidden; position: relative; height: calc(100vh - 85px); }
    
    #mapWrapper { 
      width: 55%; 
      height: 100%; 
      position: relative; 
      border-right: 1px solid #1e293b; 
      transition: width 0.3s ease-in-out;
    }

    #map { position: absolute; top:0; bottom:0; left:0; right:0; z-index: 1; }

    #areaRelatorioPdf { 
      width: 45%; 
      height: 100%; 
      background-color: #0f172a; 
      display: flex; 
      flex-direction: column; 
      transition: width 0.3s ease-in-out, opacity 0.2s ease;
      overflow: hidden;
    }

    .main-container.painel-recolhido #mapWrapper { width: 100% !important; border-right: none; }
    .main-container.painel-recolhido #areaRelatorioPdf { width: 0% !important; opacity: 0; pointer-events: none; }

    .btn-toggle-painel {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 9999;
      background-color: #1e293b;
      color: #38bdf8;
      border: 1px solid #334155;
      padding: 8px 12px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 11px;
      font-weight: bold;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .btn-toggle-painel:hover { background-color: #334155; color: #ffffff; transform: scale(1.03); }

    .header-tabela { padding: 12px; background-color: rgba(30, 41, 59, 0.5); border-bottom: 1px solid #1e293b; display: flex; justify-content: space-between; align-items: center; }
    .tabela-container { flex: 1; overflow-y: auto; padding: 8px; }

    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 10px; }
    th { position: sticky; top: 0; background-color: #1e293b; color: #94a3b8; padding: 8px 6px; text-transform: uppercase; font-size: 9px; font-weight: bold; z-index: 10; border-bottom: 1px solid #334155; }
    td { padding: 8px 6px; border-bottom: 1px solid #1e293b; vertical-align: middle; }
    tr:hover { background-color: rgba(30, 41, 59, 0.8); }

    .badge-id-os {
      font-weight: 800; font-size: 10px; color: #38bdf8; background: rgba(56, 189, 248, 0.15);
      border: 1px solid rgba(56, 189, 248, 0.3); padding: 1px 5px; border-radius: 4px;
      display: inline-block; margin-bottom: 2px;
    }

    .custom-dot { width: 13px; height: 13px; border-radius: 50%; border: 2px solid #ffffff; transition: all 0.2s ease; opacity: 0.4; }
    .custom-dot-ativo { opacity: 1 !important; transform: scale(1.2); z-index: 999; }

    .custom-dot-inviavel {
      width: 16px;
      height: 16px;
      background-color: #ef4444 !important;
      border: 2px solid #ffffff;
      transform: rotate(45deg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.9);
      opacity: 0.8;
      z-index: 998;
    }
    .custom-dot-ativo.custom-dot-inviavel {
      opacity: 1 !important;
      transform: rotate(45deg) scale(1.3);
      box-shadow: 0 0 14px rgba(239, 68, 68, 1);
    }

    .dot-datacenter { background-color: #2563eb; }
    .dot-torre      { background-color: #9333ea; }
    .dot-loja       { background-color: #16a34a; }
    .dot-estoque    { background-color: #d97706; }
    .dot-outros     { background-color: #ef4444; }
    
    .custom-dot-ativo.dot-datacenter { box-shadow: 0 0 12px rgba(37, 99, 235, 1); }
    .custom-dot-ativo.dot-torre      { box-shadow: 0 0 12px rgba(147, 51, 234, 1); }
    .custom-dot-ativo.dot-loja       { box-shadow: 0 0 12px rgba(22, 163, 74, 1); }
    .custom-dot-ativo.dot-estoque    { box-shadow: 0 0 12px rgba(217, 119, 6, 1); }
    .custom-dot-ativo.dot-outros     { box-shadow: 0 0 12px rgba(239, 68, 68, 1); }

    .ponto-agendado-preto {
      background-color: #000000 !important;
    }
    .custom-dot-ativo.ponto-agendado-preto {
      box-shadow: 0 0 12px rgba(0, 0, 0, 1);
    }

    .dot-partida    { background-color: #f59e0b; border: 2px solid #fff; box-shadow: 0 0 14px rgba(245, 158, 11, 1); width: 22px; height: 22px; opacity: 1 !important; z-index: 1000; font-size: 11px; display: flex; align-items: center; justify-content: center; }

    .dropdown-menu-box { position: absolute; top: 100%; left: 0; margin-top: 4px; background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 8px; max-height: 250px; overflow-y: auto; z-index: 100; min-width: 180px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.5); }
    .dropdown-menu-box.hidden { display: none; }

    .badge-btn { background-color: rgba(37, 99, 235, 0.2); color: #60a5fa; border: 1px solid rgba(37, 99, 235, 0.3); font-weight: bold; border-radius: 6px; padding: 0 10px; height: 32px; display: inline-flex; align-items: center; font-size: 11px; }
    .badge-semgps { background-color: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-weight: bold; border-radius: 6px; padding: 0 10px; height: 32px; display: inline-flex; align-items: center; font-size: 11px; cursor: pointer; }

    .grid-calendario { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-top: 10px; flex: 1; }
    .cal-day-box {
      min-height: 110px; background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 8px;
      display: flex; flex-direction: column; justify-content: space-between; transition: all 0.2s ease;
    }
    .cal-day-box:hover { border-color: #60a5fa; background: #26334d; }
    .cal-day-box.hoje-highlight { border-color: #10b981; box-shadow: 0 0 10px rgba(16, 185, 129, 0.3); }
    .badge-equipe-pilula {
      display: block; font-size: 10px; font-weight: bold; padding: 4px 8px; border-radius: 5px;
      margin-top: 4px; cursor: pointer; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; text-align: center;
      box-shadow: 0 2px 5px rgba(0,0,0,0.4); transition: transform 0.1s ease;
    }
    .badge-equipe-pilula:hover { transform: scale(1.05); }

    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px);
      z-index: 10000; display: flex; align-items: center; justify-content: center;
    }
    .modal-overlay.hidden { display: none !important; }
    .modal-box {
      background: #1e293b; border: 1px solid #334155; border-radius: 10px;
      width: 90%; max-width: 650px; max-height: 85vh; overflow-y: auto;
      padding: 16px; color: #f8fafc; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 10px; margin-bottom: 12px; }
    .modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 11px; }
    .modal-item { background: #0f172a; padding: 8px; border-radius: 6px; border: 1px solid #334155; }
    .modal-item.full { grid-column: span 2; }
    .modal-item label { color: #94a3b8; font-size: 10px; font-weight: bold; display: block; margin-bottom: 2px; text-transform: uppercase; }

    .apenas-impressao-pdf { display: none; }

    .topo-usuario {
      display: flex; align-items: center; gap: 8px;
      font-size: 11px; color: #94a3b8; font-weight: bold;
    }
    .topo-usuario .nome-user { color: #38bdf8; }
    .btn-sair {
      background: transparent; border: 1px solid #ef4444; color: #f87171;
      padding: 5px 10px; border-radius: 6px; font-size: 11px; font-weight: bold; cursor: pointer;
    }
    .btn-sair:hover { background: #ef4444; color: #fff; }

    @media print {
      html, body { height: auto !important; overflow: visible !important; background: white !important; color: black !important; }
      header, #mapWrapper, .no-print, .legenda-bar, .btn-toggle-painel, .modal-overlay, .col-dias-tela, .col-acoes-tela, #secaoAgenda, .tela-login { display: none !important; }
      .col-pdf-only { display: table-cell !important; }
      .main-container { display: block !important; height: auto !important; overflow: visible !important; }
      #areaRelatorioPdf { width: 100% !important; height: auto !important; background: white !important; color: black !important; display: block !important; opacity: 1 !important; }
      .tabela-container { height: auto !important; max-height: none !important; overflow: visible !important; }
      table { width: 100% !important; border-collapse: collapse !important; color: black !important; page-break-inside: auto; }
      tr { page-break-inside: avoid; page-break-after: auto; }
      th, td { border: 1px solid #cbd5e1 !important; padding: 6px !important; color: black !important; }
      th { background-color: #f1f5f9 !important; }
      .badge-id-os { background: none !important; border: none !important; color: black !important; padding: 0 !important; font-weight: bold !important; }
      .apenas-impressao-pdf { display: block !important; page-break-before: always; margin-top: 20px; }
    }
  </style>
</head>
<body>

  <!-- ================= TELA DE LOGIN ================= -->
  <div id="telaLogin" class="tela-login">
    <div class="login-card">
      <h1>🔐 Acesso ao Painel</h1>
      <p class="sub">Informe seu login e senha para continuar.</p>

      <div id="loginAvisoTroca" class="login-aviso" style="display:none;">
        Primeiro acesso detectado. Você precisa definir uma nova senha.
      </div>

      <label>Login</label>
      <input type="text" id="loginUsuario" autocomplete="username" placeholder="seu.login">

      <label>Senha</label>
      <input type="password" id="loginSenha" autocomplete="current-password" placeholder="••••••••">

      <!-- Campos de troca de senha (aparecem só quando necessário) -->
      <div id="blocoTrocaSenha" style="display:none;">
        <label>Nova senha</label>
        <input type="password" id="loginNovaSenha" placeholder="mínimo 4 caracteres">
        <label>Confirmar nova senha</label>
        <input type="password" id="loginNovaSenha2" placeholder="repita a nova senha">
      </div>

      <button class="primario" id="btnLogin" onclick="executarLogin()">Entrar</button>
      <div class="login-erro" id="loginErro"></div>
    </div>
  </div>

  <!-- CABEÇALHO -->
  <header class="no-print">
    <div class="titulo-box">
      <h1>Painel de Rotas e Ocorrências</h1>
    </div>

    <div style="display: flex; gap: 4px; background: #0f172a; padding: 3px; border-radius: 8px; border: 1px solid #334155;">
      <div id="btnAbaMapa" onclick="alternarAbaPrincipal('mapa')" class="aba-nav-item ativa">Mapa & Rotas</div>
      <div id="btnAbaAgenda" onclick="alternarAbaPrincipal('agenda')" class="aba-nav-item">Agenda Planejamento</div>
    </div>

    <div class="topo-usuario">
      <span>👤 <span class="nome-user" id="lblUsuarioLogado">—</span></span>
      <button class="btn-sair" onclick="fazerLogout()">Sair</button>
    </div>

    <div class="painel-filtros" id="barFiltrosTopo">
      
      <div style="position: relative;" class="dropdown-multiselect">
        <button onclick="toggleDropdown('menuUf', event)" class="btn-filt">
          <span id="txtBtnUf">Todas UFs</span> ▼
        </button>
        <div id="menuUf" class="dropdown-menu-box hidden">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 4px; margin-bottom: 6px; font-size: 10px;">
            <b style="color: #94a3b8;">UFs</b>
            <div>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkUf', true)" style="color:#60a5fa; margin-right:8px;">Marcar</a>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkUf', false)" style="color:#fbbf24;">Limpar</a>
            </div>
          </div>
          <div id="containerCheckboxesUf"></div>
        </div>
      </div>

      <div style="position: relative;" class="dropdown-multiselect">
        <button onclick="toggleDropdown('menuCidade', event)" class="btn-filt">
          <span id="txtBtnCidade">Todas Cidades</span> ▼
        </button>
        <div id="menuCidade" class="dropdown-menu-box hidden" style="width: 220px;">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 4px; margin-bottom: 6px; font-size: 10px;">
            <b style="color: #94a3b8;">Cidades</b>
            <div>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkCidade', true)" style="color:#60a5fa; margin-right:8px;">Marcar</a>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkCidade', false)" style="color:#fbbf24;">Limpar</a>
            </div>
          </div>
          <input type="text" id="inputBuscaCidadeDrop" oninput="filtrarListaCidadesNoDrop()" placeholder="Pesquisar cidade..." style="width: 100%; margin-bottom: 6px; padding: 4px 6px;">
          <div id="containerCheckboxesCidade" style="max-height: 150px; overflow-y: auto;"></div>
        </div>
      </div>

      <div style="position: relative;" class="dropdown-multiselect">
        <button onclick="toggleDropdown('menuTipos', event)" class="btn-filt">
          <span id="txtBtnTipos">Todos os Tipos</span> ▼
        </button>
        <div id="menuTipos" class="dropdown-menu-box hidden">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 4px; margin-bottom: 6px; font-size: 10px;">
            <b style="color: #94a3b8;">Tipos</b>
            <div>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkTipo', true)" style="color:#60a5fa; margin-right:8px;">Marcar</a>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkTipo', false)" style="color:#fbbf24;">Limpar</a>
            </div>
          </div>
          <div id="containerCheckboxesTipos"></div>
        </div>
      </div>

      <div style="position: relative;" class="dropdown-multiselect">
        <button onclick="toggleDropdown('menuSituacao', event)" class="btn-filt">
          <span id="txtBtnSituacao">Todas Situações</span> ▼
        </button>
        <div id="menuSituacao" class="dropdown-menu-box hidden">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 4px; margin-bottom: 6px; font-size: 10px;">
            <b style="color: #94a3b8;">Situação</b>
            <div>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkSit', true)" style="color:#60a5fa; margin-right:8px;">Marcar</a>
              <a href="javascript:void(0)" onclick="marcarGrupo('chkSit', false)" style="color:#fbbf24;">Limpar</a>
            </div>
          </div>
          <div id="containerCheckboxesSit"></div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 4px;">
        <span style="font-size: 10px; color: #94a3b8; font-weight: bold;">Backlog até:</span>
        <input type="date" id="inputDataBacklog" onchange="aplicarFiltrosGlobais()" title="Filtrar pendências iniciadas até esta data">
        <button onclick="limparFiltroDataBacklog()" class="btn-filt" style="padding: 0 6px; color: #f87171;" title="Limpar Data Limite">✕</button>
      </div>

      <button id="btnModoMedicao" onclick="toggleModoMedicao()" class="btn-filt" style="border-color: #10b981; color: #34d399;">
        Medir Distância
      </button>

      <button id="btnModoRota" onclick="toggleModoRota()" class="btn-filt" style="border-color: #64748b; color: #e2e8f0;" title="Destaca em preto tudo que já está agendado, em qualquer data/equipe">
        Modo Rota
      </button>

      <button id="btnExibirSemGps" onclick="filtrarApenasSemGps()" class="badge-semgps">
        Sem GPS (<span id="txtQtdSemGps">0</span>)
      </button>

      <button onclick="limparTudoGeral()" class="btn-filt" style="color: #fbbf24; border-color: #fbbf24; font-weight: bold;">Limpar Tudo</button>
      
      <button onclick="carregarPontos()" class="btn-filt" style="background-color: #2563eb; font-weight: bold;">Atualizar</button>
    </div>
  </header>

  <!-- LEGENDA DO MAPA -->
  <div class="legenda-bar no-print" id="barraLegendaMap">
    <b style="color: #94a3b8;">LEGENDA:</b>
    <div id="legendaConteudoPontos" style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
      <span><span class="dot-legenda" style="background:#f59e0b;"></span> Sede Matriz</span>
      <span><span class="dot-legenda" style="background:#2563eb;"></span> Data Center</span>
      <span><span class="dot-legenda" style="background:#9333ea;"></span> Torre / 5G</span>
      <span><span class="dot-legenda" style="background:#16a34a;"></span> Loja / Shopping</span>
      <span><span class="dot-legenda" style="background:#d97706;"></span> Estoque / CD</span>
      <span><span class="dot-legenda" style="background:#ef4444;"></span> Outros</span>
      <span style="color: #ef4444; font-weight: bold;"><span class="dot-legenda" style="background:#ef4444; border-radius:2px; transform: rotate(45deg);"></span> Inviável (Losango)</span>
      <span style="color: #8b5cf6; font-weight: bold;"><span class="dot-legenda" style="background:rgba(139,92,246,0.3); border:1px dashed #8b5cf6;"></span> Área Agendada</span>
      <span id="legendaModoRota" style="color: #e2e8f0; font-weight: bold; display: none;"><span class="dot-legenda" style="background:#000000; border:1px solid #fff;"></span> Já Agendado (Modo Rota)</span>
    </div>
  </div>

  <!-- SEÇÃO 1: PAINEL PRINCIPAL DO MAPA E TABELA -->
  <div class="main-container" id="secaoMapaContainer">
    
    <div id="mapWrapper" class="no-print">
      <button onclick="togglePainelLateral()" class="btn-toggle-painel" id="btnTogglePainel">
        <span id="txtIconeToggle">▶</span> <span id="txtRotuloToggle">Ocultar Tabela</span>
      </button>

      <div id="map"></div>
    </div>

    <div id="areaRelatorioPdf">
      <div class="header-tabela">
        <div>
