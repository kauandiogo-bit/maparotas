    function carregarRotaNoMapaEIr() {
      if (!rotaAtivaCalData || !rotaAtivaCalEquipe) return;
      
      let pontosDaRota = todosOsPontos.filter(function(p) { 
        return p.dataAgendadaIso === rotaAtivaCalData && 
               p.equipe && 
               p.equipe.trim().toUpperCase() === rotaAtivaCalEquipe.trim().toUpperCase(); 
      });
      
      if (pontosDaRota.length === 0) {
        alert("Nenhum ponto encontrado para esta rota.");
        return;
      }

      fecharModalRotaCalendario();
      alternarAbaPrincipal('mapa');

      drawnItems.clearLayers();
      formaDesenhadaAtiva = null;

      let pontoComArea = pontosDaRota.find(function(p) { return p.areaGeoJson && p.areaGeoJson.trim() !== ""; });
      
      if (pontoComArea) {
        try {
          let geoData = JSON.parse(pontoComArea.areaGeoJson);
          
          if (geoData.tipo === "circulo") {
            formaDesenhadaAtiva = L.circle([geoData.lat, geoData.lng], {
              radius: geoData.raio, color: '#8b5cf6', weight: 2, fillColor: '#8b5cf6', fillOpacity: 0.2
            });
          } else if (geoData.tipo === "retangulo") {
            formaDesenhadaAtiva = L.rectangle(geoData.bounds, {
              color: '#8b5cf6', weight: 2, fillColor: '#8b5cf6', fillOpacity: 0.2
            });
          } else if (geoData.tipo === "poligono") {
            formaDesenhadaAtiva = L.polygon(geoData.latlngs, {
              color: '#8b5cf6', weight: 2, fillColor: '#8b5cf6', fillOpacity: 0.2
            });
          }

          if (formaDesenhadaAtiva) {
            drawnItems.addLayer(formaDesenhadaAtiva);
          }
        } catch(e) {
          console.error("Erro ao redesenhar área salva:", e);
        }
      }

      renderizarMarcadoresELinhasNoMapa(pontosDaRota, pontosDaRota);
      renderizarTabela(pontosDaRota);

      let pontosComGps = pontosDaRota.filter(function(p) { return !p.semGps && p.lat !== null && p.lng !== null; });
      if (pontosComGps.length > 0) {
        let bounds = L.latLngBounds(pontosComGps.map(function(p) { return [p.lat, p.lng]; }));
        map.fitBounds(bounds, { padding: [80, 80], maxZoom: 15 });
      } else if (formaDesenhadaAtiva) {
        map.fitBounds(formaDesenhadaAtiva.getBounds(), { padding: [50, 50] });
      }
    }

